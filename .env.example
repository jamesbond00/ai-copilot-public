# General Configuration
MONITORING_SYSTEM=elk # Options: elk, prometheus, splunk

# OpenAI Configuration (Optional, for Hybrid mode)
OPENAI_API_KEY=sk-your-openai-key-here

# Monitoring System Connection Details
# Elasticsearch
ELASTICSEARCH_URL=http://host.docker.internal:9200
ELASTICSEARCH_INDEX=logstash-*

# Prometheus
PROMETHEUS_URL=http://host.docker.internal:9090

# Splunk
SPLUNK_URL=https://host.docker.internal:8089
SPLUNK_TOKEN=your-splunk-token

# Ollama Configuration
OLLAMA_HOST=http://ollama:11434 # Internal docker network address
